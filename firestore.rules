rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwnerAdmin() {
      return signedIn() && request.auth.token.email == "leonelsquare7@gmail.com";
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwnerAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'lastSeen'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isOwnerAdmin();
    }

    // Public directory exposes only display names, never private email or account fields.
    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'lastSeen'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/devices/{tokenId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      allow read: if isMember();
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1];
      allow update: if isMember()
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt', 'readAt', 'disappearSeconds'])
        && (!('disappearSeconds' in request.resource.data)
          || request.resource.data.disappearSeconds in [0, 60, 3600, 86400, 604800]);
      allow delete: if false;

      match /messages/{messageId} {
        function chatMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if chatMember();
        allow create: if chatMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.type in ['text', 'image', 'voice']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.viewLimit in [0, 1, 2]
          && request.resource.data.viewCount == 0
          && request.resource.data.deletedForEveryone == false
          && request.resource.data.deletedFor is list
          && request.resource.data.createdAt == request.time;
        allow update: if chatMember() && (
          (resource.data.senderId == request.auth.uid
            && request.resource.data.deletedForEveryone == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deletedForEveryone', 'text', 'storagePath', 'deletedAt']))
          ||
          (request.resource.data.deletedFor is list
            && request.auth.uid in request.resource.data.deletedFor
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']))
          ||
          (resource.data.receiverId == request.auth.uid
            && request.resource.data.viewCount == resource.data.viewCount + 1
            && request.resource.data.viewedBy.hasAll([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['viewCount', 'viewedBy']))
        );
        allow delete: if false;
      }

      match /calls/{callId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.resource.data.callerId == request.auth.uid
          && request.resource.data.calleeId in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.calleeId != request.auth.uid
          && request.resource.data.status == 'ringing';
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answeredAt', 'endedAt']);
        allow delete: if false;
      }
    }

    match /ai_usage/{userId} {
      allow read, write: if false;
    }

    match /user_bans/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwnerAdmin());
      allow create, update, delete: if isOwnerAdmin();
    }

    match /admin_audit/{entryId} {
      allow read, create: if isOwnerAdmin();
      allow update, delete: if false;
    }

    match /device_directory/{installationId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == installationId
        && request.resource.data.keys().hasOnly(['manufacturer', 'model', 'androidVersion', 'sdkInt', 'appVersion', 'appVersionCode', 'primaryAbi', 'lastSeen'])
        && request.resource.data.manufacturer is string
        && request.resource.data.model is string
        && request.resource.data.androidVersion is string
        && request.resource.data.sdkInt is int
        && request.resource.data.appVersion is string
        && request.resource.data.appVersionCode is int
        && request.resource.data.primaryAbi is string
        && request.resource.data.lastSeen == request.time;
      allow delete: if (signedIn() && request.auth.uid == installationId) || isOwnerAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isOwnerAdmin()
        && request.resource.data.keys().hasOnly(['title', 'message', 'createdBy', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdBy == "leonelsquare7@gmail.com"
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwnerAdmin();
    }
  }
}