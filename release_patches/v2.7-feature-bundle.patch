@@ -0,0 +1,28 @@
+package com.mediahub.rebuilt;
+
+import android.app.Activity;
+import android.app.PendingIntent;
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.provider.MediaStore;
+import android.widget.ArrayAdapter;
+import android.widget.LinearLayout;
+import android.widget.ListView;
+import android.widget.TextView;
+import android.widget.Toast;
+import java.util.*;
+
+/** Storage analyzer. It only recommends cleanup; deletion always requires Android's confirmation UI. */
+public class SmartStorageActivity extends Activity {
+    private static class Entry {String name;long size;Uri uri;Entry(String n,long s,Uri u){name=n;size=s;uri=u;}}
+    private final ArrayList<Entry> entries=new ArrayList<>();private final ArrayList<String> labels=new ArrayList<>();private ArrayAdapter<String> adapter;private TextView summary;private static final int DELETE_REQ=7101;
+    @Override public void onCreate(Bundle b){super.onCreate(b);LinearLayout root=new LinearLayout(this);root.setOrientation(1);root.setPadding(20,24,20,16);root.setBackgroundColor(0xff08080c);TextView title=new TextView(this);title.setText("SMART STORAGE");title.setTextColor(0xffff4775);title.setTextSize(20);root.addView(title);summary=new TextView(this);summary.setTextColor(0xffded8e0);summary.setPadding(0,12,0,14);root.addView(summary);ListView list=new ListView(this);adapter=new ArrayAdapter<>(this,android.R.layout.simple_list_item_1,labels);list.setAdapter(adapter);root.addView(list,new LinearLayout.LayoutParams(-1,0,1));list.setOnItemClickListener((p,v,pos,id)->showEntry(pos));setContentView(root);scan();}
+    private void scan(){entries.clear();labels.clear();long total=0;Uri base=MediaStore.Files.getContentUri("external");String[] cols={MediaStore.MediaColumns._ID,MediaStore.MediaColumns.DISPLAY_NAME,MediaStore.MediaColumns.SIZE,MediaStore.MediaColumns.MIME_TYPE};try(Cursor c=getContentResolver().query(base,cols,MediaStore.MediaColumns.SIZE+">0 AND ("+MediaStore.MediaColumns.MIME_TYPE+" LIKE 'audio/%' OR "+MediaStore.MediaColumns.MIME_TYPE+" LIKE 'video/%' OR "+MediaStore.MediaColumns.MIME_TYPE+" LIKE 'image/%')",null,MediaStore.MediaColumns.SIZE+" DESC")){if(c!=null){int ix=c.getColumnIndexOrThrow(MediaStore.MediaColumns._ID),nm=c.getColumnIndexOrThrow(MediaStore.MediaColumns.DISPLAY_NAME),sz=c.getColumnIndexOrThrow(MediaStore.MediaColumns.SIZE),mi=c.getColumnIndexOrThrow(MediaStore.MediaColumns.MIME_TYPE);while(c.moveToNext()){long size=c.getLong(sz);total+=size;if(entries.size()<100){Uri item=Uri.withAppendedPath(base,String.valueOf(c.getLong(ix)));entries.add(new Entry(c.getString(nm),size,item));}}}}catch(Exception ignored){}for(Entry e:entries)labels.add(e.name+"\n"+human(e.size));summary.setText("Indexed top files: "+entries.size()+"     Approx. media size: "+human(total)+"\nTap a file to review it. Nothing is deleted automatically.");adapter.notifyDataSetChanged();}
+    private void showEntry(int pos){Entry e=entries.get(pos);new android.app.AlertDialog.Builder(this).setTitle(e.name).setMessage("Size: "+human(e.size)+"\n\nReview before deleting. Android will ask you to confirm any deletion.").setPositiveButton("Delete…",(d,w)->delete(e)).setNegativeButton("Keep",null).show();}
+    private void delete(Entry e){if(Build.VERSION.SDK_INT>=30){try{PendingIntent pi=MediaStore.createDeleteRequest(getContentResolver(),Collections.singletonList(e.uri));startIntentSenderForResult(pi.getIntentSender(),DELETE_REQ,null,0,0,0);}catch(Exception x){Toast.makeText(this,"Could not request deletion.",Toast.LENGTH_SHORT).show();}}else Toast.makeText(this,"Use your device's file manager to remove this item.",Toast.LENGTH_LONG).show();}
+    @Override protected void onActivityResult(int r,int c,Intent d){super.onActivityResult(r,c,d);if(r==DELETE_REQ&&c==RESULT_OK)scan();}
+    private String human(long n){if(n<1024)return n+" B";if(n<1024*1024)return String.format(Locale.getDefault(),"%.1f KB",n/1024f);if(n<1024L*1024*1024)return String.format(Locale.getDefault(),"%.1f MB",n/(1024f*1024));return String.format(Locale.getDefault(),"%.2f GB",n/(1024d*1024*1024));}
+}
diff --git a/app/src/main/java/com/mediahub/rebuilt/VaultActivity.java b/app/src/main/java/com/mediahub/rebuilt/VaultActivity.java
