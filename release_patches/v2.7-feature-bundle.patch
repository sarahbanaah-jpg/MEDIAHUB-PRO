+package com.mediahub.rebuilt;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+import android.widget.ArrayAdapter;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ListView;
+import android.widget.TextView;
+import android.widget.Toast;
+import android.app.AlertDialog;
+import java.io.*;
+import java.security.KeyStore;
+import java.util.*;
+import javax.crypto.Cipher;
+import javax.crypto.CipherInputStream;
+import javax.crypto.CipherOutputStream;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+
+/** Private local vault. Files are AES-256-GCM encrypted before being written to app-private storage. */
+public class VaultActivity extends Activity {
+    private static final int PICK_IMPORT=6101, PICK_EXPORT=6102;
+    private final ArrayList<String> ids=new ArrayList<>(), names=new ArrayList<>();
+    private ArrayAdapter<String> adapter;
+    private int selected=-1;
+    private File vaultDir;
+    @Override public void onCreate(Bundle b){super.onCreate(b);vaultDir=new File(getFilesDir(),"private_vault");if(!vaultDir.exists())vaultDir.mkdirs();
+        LinearLayout root=new LinearLayout(this);root.setOrientation(1);root.setPadding(22,28,22,20);root.setBackgroundColor(0xff08080c);
+        TextView title=new TextView(this);title.setText("PRIVATE VAULT");title.setTextColor(0xffff4775);title.setTextSize(20);title.setPadding(0,0,0,10);root.addView(title);
+        TextView note=new TextView(this);note.setText("Files are encrypted on this device with AES-256-GCM. The encryption key stays in Android Keystore.");note.setTextColor(0xffc9c2cb);note.setTextSize(13);root.addView(note);
+        Button add=new Button(this);add.setText("＋  IMPORT FILE SECURELY");root.addView(add);add.setOnClickListener(v->pickImport());
+        ListView list=new ListView(this);adapter=new ArrayAdapter<>(this,android.R.layout.simple_list_item_1,names);list.setAdapter(adapter);root.addView(list,new LinearLayout.LayoutParams(-1,0,1));
+        list.setOnItemClickListener((p,v,pos,id)->{selected=pos;exportSelected();});
+        list.setOnItemLongClickListener((p,v,pos,id)->{new AlertDialog.Builder(this).setTitle(names.get(pos)).setItems(new String[]{"Export / decrypt","Delete encrypted copy"},(d,w)->{selected=pos;if(w==0)exportSelected();else deleteSelected();}).show();return true;});
+        setContentView(root);reload();
+    }
+    private void pickImport(){Intent i=new Intent(Intent.ACTION_OPEN_DOCUMENT).setType("*/*").addCategory(Intent.CATEGORY_OPENABLE);startActivityForResult(i,PICK_IMPORT);}
+    @Override protected void onActivityResult(int request,int result,Intent data){super.onActivityResult(request,result,data);if(result!=RESULT_OK||data==null||data.getData()==null)return;try{if(request==PICK_IMPORT)encryptImport(data.getData());else if(request==PICK_EXPORT)decryptExport(data.getData());}catch(Exception e){Toast.makeText(this,"Vault operation failed: "+e.getMessage(),Toast.LENGTH_LONG).show();}}
+    private SecretKey getKey() throws Exception {KeyStore ks=KeyStore.getInstance("AndroidKeyStore");ks.load(null);if(ks.containsAlias("mediahub_vault_aes"))return (SecretKey)ks.getKey("mediahub_vault_aes",null);KeyGenerator kg=KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES,"AndroidKeyStore");kg.init(new KeyGenParameterSpec.Builder("mediahub_vault_aes",KeyProperties.PURPOSE_ENCRYPT|KeyProperties.PURPOSE_DECRYPT).setBlockModes(KeyProperties.BLOCK_MODE_GCM).setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE).setKeySize(256).build());return kg.generateKey();}
+    private void encryptImport(Uri uri)throws Exception {String display="Protected file";android.database.Cursor c=getContentResolver().query(uri,new String[]{android.provider.OpenableColumns.DISPLAY_NAME},null,null,null);if(c!=null){if(c.moveToFirst())display=c.getString(0);c.close();}String id=UUID.randomUUID().toString();Cipher cipher=Cipher.getInstance("AES/GCM/NoPadding");cipher.init(Cipher.ENCRYPT_MODE,getKey());File out=new File(vaultDir,id+".mhv");try(InputStream in=getContentResolver().openInputStream(uri);OutputStream raw=new BufferedOutputStream(new FileOutputStream(out))){raw.write(cipher.getIV());try(CipherOutputStream encrypted=new CipherOutputStream(raw,cipher)){byte[] buf=new byte[8192];int n;while((n=in.read(buf))!=-1)encrypted.write(buf,0,n);}}getPreferences(0).edit().putString(id,display==null?"Protected file":display).apply();reload();Toast.makeText(this,"File encrypted and added to your private vault.",Toast.LENGTH_LONG).show();}
+    private void exportSelected(){if(selected<0||selected>=ids.size())return;String name=names.get(selected);Intent i=new Intent(Intent.ACTION_CREATE_DOCUMENT).setType("application/octet-stream").addCategory(Intent.CATEGORY_OPENABLE).putExtra(Intent.EXTRA_TITLE,name);startActivityForResult(i,PICK_EXPORT);}
+    private void decryptExport(Uri target)throws Exception {String id=ids.get(selected);File src=new File(vaultDir,id+".mhv");try(InputStream raw=new BufferedInputStream(new FileInputStream(src))){byte[] iv=new byte[12];DataInputStream header=new DataInputStream(raw);header.readFully(iv);Cipher cipher=Cipher.getInstance("AES/GCM/NoPadding");cipher.init(Cipher.DECRYPT_MODE,getKey(),new GCMParameterSpec(128,iv));try(CipherInputStream in=new CipherInputStream(raw,cipher);OutputStream out=getContentResolver().openOutputStream(target)){byte[] buf=new byte[8192];int n;while((n=in.read(buf))!=-1)out.write(buf,0,n);}}Toast.makeText(this,"Decrypted file exported to your chosen location.",Toast.LENGTH_LONG).show();}
+    private void deleteSelected(){if(selected<0||selected>=ids.size())return;String id=ids.get(selected);new File(vaultDir,id+".mhv").delete();getPreferences(0).edit().remove(id).apply();reload();}
+    private void reload(){ids.clear();names.clear();Map<String,?> all=getPreferences(0).getAll();for(String id:all.keySet()){if(new File(vaultDir,id+".mhv").exists()){ids.add(id);names.add(String.valueOf(all.get(id)));}}if(adapter!=null)adapter.notifyDataSetChanged();}
+}
