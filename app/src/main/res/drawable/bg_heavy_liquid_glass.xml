<?xml version="1.0" encoding="utf-8"?>
<!--
  Android approximation of:
  backdrop-filter: blur(18px) saturate(160%);
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.35);
  + specular highlight (feSpecularLighting-like top light)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft outer glow rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#28FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Frosted body ~12% white over dark glass -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#99141A22" />
            <corners android:radius="23dp" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
    <!-- Specular highlight (point light from upper-left) -->
    <item
        android:left="10dp"
        android:top="1.5dp"
        android:right="10dp"
        android:bottom="28dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#66FFFFFF"
                android:centerColor="#22FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
    <!-- Lower refraction tint -->
    <item
        android:left="8dp"
        android:top="36dp"
        android:right="8dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#1800FFAA"
                android:endColor="#00000000" />
            <corners
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
