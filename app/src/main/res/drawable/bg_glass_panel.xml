<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass panel: dark green-black glassmorphism -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22A8FFCE" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC0E1614" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#55A8FFCE" />
        </shape>
    </item>
    <item
        android:left="12dp"
        android:top="1.5dp"
        android:right="12dp"
        android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
